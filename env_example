# PostgreSQL (required)
HIREBEAN_DB_USERNAME=hirebean
HIREBEAN_DB_PASS=change-this-database-password
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/hirebean_db

# Gmail SMTP (required for password-reset email delivery)
MAIL_USERNAME=your-account@gmail.com
MAIL_PASSWORD=replace-with-an-app-password

# Application URLs and HTTP port
APP_BACKEND_URL=http://localhost:8080
APP_FRONTEND_URL=http://localhost:3000
PORT=8080

# Authentication (required; replace with a random value of at least 32 characters)
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long

# Local demo content (never enable in shared or production environments)
APP_SEED_DEMO_DATA=false

# Supabase Storage (required for uploads and file links)
SUPABASE_URL=https://your-project-ref.supabase.co
# The current Java REST client expects the legacy server-only service_role JWT.
# Never expose this value to the frontend or commit a populated .env file.
SUPABASE_SECRET_KEY=replace-with-the-server-only-service-role-key
SUPABASE_PUBLIC_BUCKET=hirebean-public
SUPABASE_PRIVATE_BUCKET=hirebean-private
SUPABASE_SIGNED_URL_SECONDS=600
